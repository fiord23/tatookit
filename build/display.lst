 118:Core/Src/display.c **** void SSD1306_UpdateScreen(void) {
 119:Core/Src/display.c ****   unsigned char i,j=0;
 120:Core/Src/display.c **** 	for(i=0;i<0x04;i++)
 121:Core/Src/display.c **** 	{
 122:Core/Src/display.c **** 		Set_Page_Address(i);
 123:Core/Src/display.c ****   		Set_Column_Address(0x00);
 124:Core/Src/display.c ****   		for(j=0;j<0x80;j++)
 125:Core/Src/display.c **** 		{
 126:Core/Src/display.c **** 		  data(pixelBuffer[i*0x80+j]);
 127:Core/Src/display.c **** 		}
 128:Core/Src/display.c **** 	}
 129:Core/Src/display.c **** }
