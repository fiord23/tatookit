 110:Core/Src/display.c **** void SSD1306_UpdateScreen(void) {
 111:Core/Src/display.c ****   unsigned char i,j,num=0;
 112:Core/Src/display.c **** 	for(i=0;i<0x04;i++)
 113:Core/Src/display.c **** 	{
 114:Core/Src/display.c **** 	Set_Page_Address(i);
 115:Core/Src/display.c ****   Set_Column_Address(0x00);
 116:Core/Src/display.c ****   for(j=0;j<0x80;j++)
 117:Core/Src/display.c **** 		{
 118:Core/Src/display.c **** 		  data(pixelBuffer[i*0x80+j]);
 119:Core/Src/display.c **** 		}
 120:Core/Src/display.c **** 	}
 121:Core/Src/display.c **** }
